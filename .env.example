# Database
DATABASE_URL=postgres://copilot:copilot@localhost:5432/copilot?sslmode=disable

# HTTP
HTTP_ADDR=:8080
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-in-production

# LLM (OpenAI-compatible). Leave empty to use the mock provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Meta Marketing API. Leave empty to use the mock catalog.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v26.0

# Targeting cache
TARGETING_CACHE_TTL_DAYS=14
